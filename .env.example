# ==============================================================================
# MASTER FOUNDATION — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` inside your project copy and fill in real values.
# NEVER commit `.env` or real production secrets to version control.
# ==============================================================================

# --- Application ---
APP_NAME="Project Name"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:3000
HOSTING_TYPE=vps # shared_hosting | vps

# --- Localization ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=ar,en,fr,ru,de,es

# --- Database (Select ONE primary engine matching hosting capabilities) ---
# Shared Hosting default: mysql | VPS / Dedicated default: postgresql
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=change_me_db
DB_USER=change_me_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_SSL=false
# Optional single DSN format if required by chosen framework:
# DATABASE_URL=postgresql://change_me_user:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/change_me_db

# --- Authentication & Sessions ---
# Generate cryptographically random 32+ byte hex/base64 strings per environment
SESSION_SECRET=CHANGE_ME_GENERATE_MIN_32_CHAR_RANDOM_SECRET
CSRF_SECRET=CHANGE_ME_GENERATE_MIN_32_CHAR_RANDOM_SECRET
AUTH_COOKIE_NAME=site_session
SESSION_TTL_SECONDS=86400
REMEMBER_ME_TTL_SECONDS=2592000
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Auth Feature Toggles ---
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=true

# --- Email / SMTP Delivery (Required for password reset & verification) ---
# Leave SMTP_ENABLED=false until real provider credentials are configured.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me_smtp_user
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_NAME="Project Name"
MAIL_FROM_ADDRESS=no-reply@example.com

# --- File Uploads & Request Limits ---
UPLOAD_STORAGE_DRIVER=local # local | s3_compatible
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760
MAX_JSON_BODY_BYTES=1048576
MAX_FORM_BODY_BYTES=2097152
MAX_MULTIPART_REQUEST_BYTES=12582912

# --- Security & Rate Limiting ---
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_CONTACT_MAX=5

