{
  "version": "1.0.0",
  "mandatoryLanguages": ["ar", "en", "fr", "ru", "de", "es"],
  "defaultLanguage": "en",
  "persistSelection": {
    "cookieName": "site_lang",
    "cookieMaxAgeDays": 365,
    "preserveRouteOnSwitch": true,
    "allowTranslatedSlugs": true
  },
  "translationGovernance": {
    "requireExplicitHumanVerification": true,
    "flagMissingInAdmin": true,
    "flagUnverifiedInAdmin": true,
    "neverMixLanguagesFallback": "report_missing_or_unverified"
  },
  "languages": [
    {
      "code": "ar",
      "bcp47": "ar",
      "englishName": "Arabic",
      "nativeName": "العربية",
      "direction": "rtl",
      "enabledByDefault": true,
      "recommendedFontStack": "'Cairo', 'Noto Sans Arabic', system-ui, -apple-system, sans-serif"
    },
    {
      "code": "en",
      "bcp47": "en",
      "englishName": "English",
      "nativeName": "English",
      "direction": "ltr",
      "enabledByDefault": true,
      "recommendedFontStack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "code": "fr",
      "bcp47": "fr",
      "englishName": "French",
      "nativeName": "Français",
      "direction": "ltr",
      "enabledByDefault": true,
      "recommendedFontStack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "code": "ru",
      "bcp47": "ru",
      "englishName": "Russian",
      "nativeName": "Русский",
      "direction": "ltr",
      "enabledByDefault": true,
      "recommendedFontStack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "code": "de",
      "bcp47": "de",
      "englishName": "German",
      "nativeName": "Deutsch",
      "direction": "ltr",
      "enabledByDefault": true,
      "recommendedFontStack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "code": "es",
      "bcp47": "es",
      "englishName": "Spanish",
      "nativeName": "Español",
      "direction": "ltr",
      "enabledByDefault": true,
      "recommendedFontStack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    }
  ]
}

