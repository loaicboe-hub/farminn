{
  "version": "1.0.0",
  "enforcement": "server_side_mandatory",
  "defaultRoleForNewAdminCreatedUsers": "editor",
  "permissionsCatalog": [
    "dashboard.overview.view",
    "content.view",
    "content.edit",
    "pages.view",
    "pages.create",
    "pages.edit",
    "pages.publish",
    "pages.delete",
    "media.view",
    "media.upload",
    "media.replace",
    "media.delete",
    "settings.website.view",
    "settings.website.edit",
    "settings.contact.view",
    "settings.contact.edit",
    "seo.view",
    "seo.edit",
    "translations.view",
    "translations.edit",
    "translations.verify",
    "inquiries.view",
    "inquiries.manage",
    "users.view",
    "users.create",
    "users.edit",
    "users.toggle_active",
    "roles.view",
    "roles.manage",
    "security.logs.view",
    "account.self.manage",
    "modules.manage"
  ],
  "roles": {
    "super_admin": {
      "label": "Super Admin",
      "description": "Full system control including roles, permissions, users, website settings, and security logs.",
      "isSystemRole": true,
      "permissions": ["*"]
    },
    "admin": {
      "label": "Admin",
      "description": "Manages website content, pages, media, SEO, website settings, contact details, translations, and standard users without altering super-admin roles.",
      "isSystemRole": true,
      "permissions": [
        "dashboard.overview.view",
        "content.view",
        "content.edit",
        "pages.view",
        "pages.create",
        "pages.edit",
        "pages.publish",
        "media.view",
        "media.upload",
        "media.replace",
        "settings.website.view",
        "settings.website.edit",
        "settings.contact.view",
        "settings.contact.edit",
        "seo.view",
        "seo.edit",
        "translations.view",
        "translations.edit",
        "translations.verify",
        "inquiries.view",
        "inquiries.manage",
        "users.view",
        "users.create",
        "users.edit",
        "users.toggle_active",
        "roles.view",
        "security.logs.view",
        "account.self.manage",
        "modules.manage"
      ]
    },
    "editor": {
      "label": "Editor",
      "description": "Creates and edits website content, pages, media, translations, and page SEO without modifying global website settings or user accounts.",
      "isSystemRole": true,
      "permissions": [
        "dashboard.overview.view",
        "content.view",
        "content.edit",
        "pages.view",
        "pages.create",
        "pages.edit",
        "media.view",
        "media.upload",
        "media.replace",
        "seo.view",
        "seo.edit",
        "translations.view",
        "translations.edit",
        "inquiries.view",
        "account.self.manage"
      ]
    }
  },
  "customRolesPolicy": {
    "allowProjectSpecificRoles": true,
    "protectSuperAdminAccounts": "Non-super_admin users cannot edit, deactivate, or reset credentials of super_admin accounts.",
    "preventPrivilegeEscalation": "Users cannot assign roles or permissions higher than their own privilege level; only super_admin may grant wildcard or role-management permissions."
  }
}

